# Homebrew (Apple Silicon)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export HOMEBREW_NO_ANALYTICS=1

# Work around a Command Line Tools bug where clang/ld default to the newest
# SDK on disk, which can be a pre-release one (e.g. MacOSX27.sdk) whose .tbd
# files use an arch-variant syntax the installed linker can't parse yet
# ("ld: tapi error: malformed file ... unknown architecture"). Pin SDKROOT to
# the stable SDK (the `MacOSX.sdk` symlink) so clang/cargo builds that link
# system libraries succeed.
STABLE_SDK="/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
[[ -d "$STABLE_SDK" ]] && export SDKROOT="$STABLE_SDK"

# Prefer the unprefixed GNU utilities installed by Homebrew coreutils.
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  export PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
  export MANPATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnuman:${MANPATH:-}"
fi

# Terminal colors
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# NVM
export NVM_DIR="$HOME/.nvm"
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  [[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]] && source "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
  [[ -s "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ]] &&
    source "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"
fi

# Common aliases
alias ls='ls --color=auto'
alias gs='git status'

# Homebrew Bash completion, including Git completion and __git_ps1.
[[ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]] &&
  source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"

PS1='\[\e[33m\]\u\[\e[m\] \[\e[36m\]\w\[\e[m\]\[\e[32m\]$(__git_ps1)\[\e[m\]\n$ '

# User-installed command-line applications.
export PATH="$HOME/.local/bin:$PATH"

# Rust installed by rustup.
[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
